    "type": "git",
    "url": "git+https://github.com/AngelMsger/jira-cli.git"
  },
  "license": "MIT",
  "bin": {
    "jira-cli": "bin/jira-cli.js"
  },
  "main": "install.js",
  "scripts": {
    "postinstall": "node install.js",
    "test": "node --test install.test.js"
  },
  "files": [
    "bin/",
    "install.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
