# jira-cli environment configuration
# Copy to .env and fill in. All variables are optional and overridable by CLI flags.

# Jira site root URL (Cloud: https://your-org.atlassian.net, DC: https://jira.example.com)
JIRA_SERVER=https://jira.example.com/

# Backend flavor: cloud | datacenter | auto (default: auto)
JIRA_FLAVOR=auto

# --- Authentication: pick ONE scheme ---

# Data Center / Server: Personal Access Token (Bearer)
JIRA_PERSONAL_ACCESS_TOKEN=

# Basic auth (DC: username + password; Cloud: email + API token)
JIRA_USERNAME=
JIRA_PASSWORD=
JIRA_API_TOKEN=

# Default project key for `issue create` / `issue search`
JIRA_DEFAULT_PROJECT=

# Default output format: json | table | ndjson
JIRA_FORMAT=json

# Session read-only posture: 1 blocks every write before it is sent
# (override per invocation with --allow-writes)
JIRA_CLI_READ_ONLY=
